# Spark configuration.
#
# Copy this to .env and fill it in. Nothing here is a real credential.
#
#   cp .env.example .env
#
# .env is ignored by git. Keep it that way.


# Environment

ENVIRONMENT=development
DEBUG=false


# Where things live

# SQLite needs nothing installed. Point this at PostgreSQL to use that instead:
#   DATABASE_URL=postgresql+psycopg://spark:PASSWORD@localhost:5432/spark
DATABASE_URL=sqlite:///./data/spark.db

ARTIFACT_DIR=./artifacts
UPLOAD_DIR=./data/uploads
USER_MODEL_DIR=./data/user_models


# Public addresses

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
PUBLIC_DOMAIN=spark.spacesdrive.cc
DOCS_DOMAIN=docs-spark.spacesdrive.cc
GITHUB_REPO=spacesdrive/spark

# Browser origins allowed to call the API with cookies. Comma separated.
# In production this is the site itself and nothing else.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Authentication
#
# Google sign-in runs through Supabase. Copy these from the Supabase dashboard
# under Project Settings, API. Read docs/DEPLOYMENT.md for the full setup,
# including the exact URLs to paste into Google Cloud Console.

# Project URL, for example https://abcdefghijklmno.supabase.co
SUPABASE_URL=

# The anon key. This one is public by design: it is meant to sit in a browser
# bundle and grants nothing on its own.
SUPABASE_ANON_KEY=

# Only needed on older Supabase projects that still sign tokens with a shared
# HS256 secret. Newer projects publish public keys and need nothing here.
# This one is a real secret. Never commit it.
SUPABASE_JWT_SECRET=

# Signs the session cookie. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

SESSION_COOKIE_NAME=spark_session
CSRF_COOKIE_NAME=spark_csrf
SESSION_TTL_HOURS=168

# Set COOKIE_SECURE=true in production. It means the cookie is only ever sent
# over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Only needed when the API and the dashboard sit on different subdomains of one
# domain, for example .spacesdrive.cc. Leave empty otherwise.
COOKIE_DOMAIN=


# Upload and evaluation limits
#
# These are shown to users in the dashboard, so the numbers on screen are
# always the ones the server is enforcing.

MAX_UPLOAD_BYTES=26214400
MAX_TEST_ROWS=100000
MAX_TRAINING_ROWS=200000
MIN_TRAINING_ROWS=2000
MAX_FILES_PER_UPLOAD=1
MAX_MODEL_BYTES=104857600
MAX_TRAINING_SECONDS=900
MAX_CONCURRENT_JOBS=2
MAX_JOBS_PER_ORG_PER_DAY=20
DATASET_RETENTION_HOURS=24


# Rate limits, requests per minute per client

RATE_LIMIT_PUBLIC=60
RATE_LIMIT_AUTHENTICATED=240
RATE_LIMIT_SCORING=120
RATE_LIMIT_UPLOAD=10


# Model loading
#
# Loading the model takes a few seconds. Doing it at startup means the first
# request is fast and /api/health reports a failure straight away. Turn it off
# for tests and quick restarts.

EAGER_MODEL_LOAD=true


# Cost model
#
# These change which thresholds the pipeline picks, so retrain after changing
# them. Units are whatever your Amount column uses.

MS_FALSE_POSITIVE_COST=25
MS_FALSE_NEGATIVE_COST=15
MS_MANUAL_REVIEW_COST=3


# Frontend
#
# The dev server proxies /api to the backend, so the browser sees one origin
# and the session cookie stays same-site. Change this only if the API runs
# somewhere other than port 8000.

VITE_API_TARGET=http://127.0.0.1:8000


# Deployment
#
# AWS and Cloudflare credentials are NOT read from this file by any code in
# this project. They stay in the local key files, which git ignores, and are
# used only by the deployment scripts on your own machine. Nothing here is
# ever bundled into the frontend or returned by the API.
